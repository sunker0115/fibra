+    @Test
+    void overlappingApplyCommandsUseTheOriginalCasAndOnlyOneValidator(@TempDir Path work) throws Exception {
+        var marker = work.resolve("entrypoint-loaded");
+        var fixture = new JavaFixture(work, marker);
+        var source = fixture.packageSource("cas", "1.0.0");
+        try (var packages = new PluginPackageStore(work.resolve("packages"));
+             var targets = new CountingTargets(work.resolve("targets"));
+             var engine = FibraEngine.builder(packages, targets).runtimeProvider(new JavaRuntimeProvider(List.of()))
+                 .contributionKinds(ContributionKindRegistry.of(ToolContributions.KIND))
+                 .hostTerminationPort(ignored -> { }).build()) {
+            engine.startAsync().block(TIMEOUT);
+            var registry = new PluginRegistry(engine, packages, new InMemoryPluginAuditRepository());
+            registry.install(new PluginInstallRequest(source, true)).block(TIMEOUT);
+            var revision = engine.published().current().engine().target().orElseThrow().targetRevision();
+            var saves = targets.saves;
+            targets.entered = new java.util.concurrent.CountDownLatch(1);
+            targets.release = new java.util.concurrent.CountDownLatch(1);
+            var first = ApplyDeployment.builder(new DesiredInputGraph(List.of(desired(config(fixture, "first")))))
+                .expectedRevision(revision).selections(List.of(selection(registry))).configContext(ConfigContextSnapshot.empty()).build();
+            var second = ApplyDeployment.builder(new DesiredInputGraph(List.of(desired(config(fixture, "second")))))
+                .expectedRevision(revision).selections(List.of(selection(registry))).configContext(ConfigContextSnapshot.empty()).build();
+            var winner = engine.submit(first).subscribeOn(reactor.core.scheduler.Schedulers.boundedElastic()).toFuture();
+            try {
+                assertTrue(targets.entered.await(20, TimeUnit.SECONDS));
+                var subscribed = new java.util.concurrent.CountDownLatch(1);
+                var loser = engine.submit(second).doOnSubscribe(ignored -> subscribed.countDown())
+                    .subscribeOn(reactor.core.scheduler.Schedulers.boundedElastic()).toFuture();
+                assertTrue(subscribed.await(20, TimeUnit.SECONDS));
+                assertFalse(winner.isDone(), "first is held at the real durable save");
+                assertFalse(loser.isDone(), "second is subscribed while first is still in flight");
+                targets.release.countDown();
+                winner.get(20, TimeUnit.SECONDS);
+                var rejected = assertThrows(java.util.concurrent.ExecutionException.class, () -> loser.get(20, TimeUnit.SECONDS));
+                assertInstanceOf(IllegalStateException.class, rejected.getCause());
+                assertTrue(rejected.getCause().getMessage().contains("deployment target revision conflict"));
+                assertEquals(saves + 1, targets.saves);
+                assertEquals(revision + 1, targets.load().orElseThrow().target().targetRevision());
+                assertEquals("validated\n", Files.readString(work.resolve("entrypoint-loaded.validator")));
+            } finally { targets.release.countDown(); }
+        }
+    }
