+#!/bin/sh
+set -eu
+root=$1
+version=$2
+output=$3
+stage() {
+  module=$1
+  plugin=$2
+  classifier=$3
+  mkdir -p "$output/$plugin"
+  unzip -p "$root/$module/target/$module-$version$classifier.jar" META-INF/fibra/config.json > "$output/$plugin/fibra-config.json"
+  cmp "$root/$module/src/plugin/fibra-config.json" "$output/$plugin/fibra-config.json"
+}
+stage tela-model-api tela-model-api ''
+stage tela-agent-plugin tela-agent '-plugin'
+stage tela-model-deterministic-plugin tela-model-deterministic ''
+stage tela-model-openai-plugin tela-model-openai '-plugin'
