+            engine.startAsync().block();
+            var registry = new com.sstlfsj.fibra.registry.PluginRegistry(engine, packages,
+                new com.sstlfsj.fibra.registry.InMemoryPluginAuditRepository());
+            registry.install(new com.sstlfsj.fibra.registry.PluginInstallRequest(source, true)).block();
+            var ref = new com.sstlfsj.fibra.config.PluginDefinitionRef("gateway-fixture", "main", "fixture-view");
+            var before = engine.snapshot().target().orElseThrow();
+            var contract = engine.describeConfiguration(ref, before.targetRevision()).block();
+            assertFalse(contract.source().schema().canonicalJson().contains("CANARY"));
+            var invalid = com.sstlfsj.fibra.config.DesiredInputEntry.builder("view", ref)
+                .config(com.sstlfsj.fibra.value.LiteralValue.of(java.util.Map.of("UNKNOWN_KEY_CANARY", "SECRET_VALUE_CANARY")))
+                .publicationRequirement(com.sstlfsj.fibra.config.PublicationRequirement.PENDING_ALLOWED).build();
+            var failure = org.junit.jupiter.api.Assertions.assertThrows(EngineChangeException.class,
+                () -> registry.upsert(null, invalid).block());
+            var body = TelaHostGateway.errorBody(failure);
+            assertTrue(body.contains("targetSaveState=NOT_SAVED"));
+            assertTrue(body.contains("viewRevision=" + engine.published().current().viewRevision()));
+            assertFalse(body.contains("CANARY"));
+            assertFalse(registry.history().getLast().detail().contains("CANARY"));
+            assertEquals(before, engine.snapshot().target().orElseThrow());
+            assertTrue(hub.assignments().isEmpty());
+            assertFalse(output.getAll().contains("CANARY"));
+        }
+    }
