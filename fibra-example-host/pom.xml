<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sstlfsj</groupId>
    <artifactId>fibra</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>fibra-example-host</artifactId>
  <description>纯 Java Fibra PF4J 宿主与真实插件制品黑盒验收。</description>

  <dependencies>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>fibra-loader-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>fibra-example-contract-plugin</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>fibra-example-provider-plugin</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>fibra-example-consumer-plugin</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>fibra-example-host</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <proc>none</proc>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-example-plugin-artifacts</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/plugin-artifacts</outputDirectory>
              <resources>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}/fibra-example-contract-plugin/target</directory>
                  <includes><include>fibra-example-contract-*.zip</include></includes>
                  <filtering>false</filtering>
                </resource>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}/fibra-example-provider-plugin/target</directory>
                  <includes><include>fibra-example-provider-*.zip</include></includes>
                  <filtering>false</filtering>
                </resource>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}/fibra-example-consumer-plugin/target</directory>
                  <includes><include>fibra-example-consumer-*.zip</include></includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <classpathDependencyExcludes>
            <classpathDependencyExclude>com.sstlfsj:fibra-example-provider-plugin</classpathDependencyExclude>
            <classpathDependencyExclude>com.sstlfsj:fibra-example-consumer-plugin</classpathDependencyExclude>
            <classpathDependencyExclude>com.sstlfsj:fibra-example-contract-plugin</classpathDependencyExclude>
          </classpathDependencyExcludes>
          <systemPropertyVariables>
            <fibra.example.artifacts>${project.build.directory}/plugin-artifacts</fibra.example.artifacts>
            <fibra.example.host.jar>${project.build.directory}/fibra-example-host-all.jar</fibra.example.host.jar>
            <fibra.example.config>${project.basedir}/config/fibra.yaml</fibra.example.config>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <outputFile>${project.build.directory}/${project.build.finalName}-all.jar</outputFile>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sstlfsj.fibra.example.host.FibraExampleHost</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
