<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>verification.distribution</groupId>
    <artifactId>fibra-distribution-verification</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>java-plugin</artifactId>
  <dependencies>
    <dependency>
      <groupId>com.sstlfsj</groupId><artifactId>fibra-api</artifactId>
      <version>${fibra.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId><artifactId>fibra-tool-api</artifactId>
      <version>${fibra.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId><artifactId>fibra-storage</artifactId>
      <version>${fibra.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId><artifactId>fibra-cli-api</artifactId>
      <version>${fibra.version}</version><scope>provided</scope>
    </dependency>
  </dependencies>
  <build><resources><resource>
    <directory>src/main/resources</directory><filtering>true</filtering>
  </resource></resources><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-assembly-plugin</artifactId>
    <version>3.8.0</version><executions>
          <execution>
            <id>stage-plugin-configuration</id>
            <phase>process-resources</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <attach>false</attach>
              <appendAssemblyId>false</appendAssemblyId>
              <outputDirectory>${project.build.outputDirectory}</outputDirectory>
              <finalName>.</finalName>
              <archiverConfig><forced>true</forced></archiverConfig>
              <inlineDescriptors><inlineDescriptor>
                <id>plugin-configuration</id>
                <formats><format>dir</format></formats>
                <includeBaseDirectory>false</includeBaseDirectory>
                <files><file>
                  <source>${project.basedir}/src/plugin/fibra-config.json</source>
                  <outputDirectory>META-INF/fibra</outputDirectory>
                  <destName>config.json</destName>
                  <filtered>false</filtered>
                </file></files>
              </inlineDescriptor></inlineDescriptors>
            </configuration>
          </execution>
    </executions></plugin></plugins></build>
</project>
