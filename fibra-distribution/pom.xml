<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.sstlfsj</groupId>
    <artifactId>fibra</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>fibra-distribution</artifactId>
  <name>Fibra Distribution</name>
  <description>正式 Fibra 宿主、Profile、插件包和目标平台运行件的二进制发行包。</description>
  <packaging>pom</packaging>

  <properties>
    <fibra.distribution.directory>${project.build.directory}/fibra-${project.version}</fibra.distribution.directory>
    <fibra.distribution.node>node</fibra.distribution.node>
    <fibra.distribution.rg>rg</fibra.distribution.rg>
    <fibra.distribution.verify.skip>true</fibra.distribution.verify.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>fibra-cli</artifactId>
    </dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-fs</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-fs-local</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-tool-fs</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-tool-fs-search</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-subprocess</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-subprocess-local</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-shell</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-shell-local</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-tool-shell</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-storage</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-storage-json</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.sstlfsj</groupId><artifactId>fibra-tool-storage</artifactId><scope>runtime</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>reset-distribution-staging</id>
            <phase>prepare-package</phase>
            <goals><goal>clean</goal></goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${fibra.distribution.directory}</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>stage-distribution-layout</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${fibra.distribution.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/distribution</directory>
                  <filtering>false</filtering>
                  <excludes>
                    <exclude>plugins/**/fibra-package.yaml</exclude>
                  </excludes>
                </resource>
                <resource>
                  <directory>src/main/distribution</directory>
                  <filtering>true</filtering>
                  <includes>
                    <include>plugins/**/fibra-package.yaml</include>
                  </includes>
                </resource>
                <resource>
                  <directory>${project.basedir}/..</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>LICENSE</include>
                    <include>THIRD_PARTY_NOTICES.md</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>stage-host-runtime</id>
            <phase>prepare-package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${fibra.distribution.directory}/lib</outputDirectory>
              <includeScope>runtime</includeScope>
              <excludeArtifactIds>fibra-fs,fibra-fs-local,fibra-tool-fs,fibra-tool-fs-search,fibra-subprocess,fibra-subprocess-local,fibra-shell,fibra-shell-local,fibra-tool-shell,fibra-storage,fibra-storage-json,fibra-tool-storage</excludeArtifactIds>
              <overWriteIfNewer>true</overWriteIfNewer>
            </configuration>
          </execution>
          <execution>
            <id>stage-formal-plugin-packages</id>
            <phase>prepare-package</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-fs</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-fs/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-fs-local</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-fs-local/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-tool-fs</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-tool-fs/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-tool-fs-search</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-tool-fs-search/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-subprocess</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-subprocess/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-subprocess-local</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-subprocess-local/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-shell</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-shell/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-shell-local</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-shell-local/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-tool-shell</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-tool-shell/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-storage</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-storage/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-storage-json</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-storage-json/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
                <artifactItem><groupId>com.sstlfsj</groupId><artifactId>fibra-tool-storage</artifactId><outputDirectory>${fibra.distribution.directory}/plugins/fibra-tool-storage/lib</outputDirectory><destFileName>main.jar</destFileName></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>verify-runtime-staging-contract</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${project.basedir}/src/test/scripts/verify-stage-runtime.sh</executable>
              <arguments>
                <argument>${project.basedir}/src/main/scripts/stage-runtime.sh</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>stage-target-platform-runtime</id>
            <phase>prepare-package</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${project.basedir}/src/main/scripts/stage-runtime.sh</executable>
              <arguments>
                <argument>${fibra.distribution.directory}</argument>
                <argument>${fibra.distribution.node}</argument>
                <argument>${fibra.distribution.rg}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>verify-external-binary-distribution</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${fibra.distribution.verify.skip}</skip>
              <executable>${project.basedir}/src/test/scripts/verify-archive.sh</executable>
              <arguments>
                <argument>${project.build.directory}/fibra-${project.version}-bin.zip</argument>
                <argument>${project.version}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>assemble-binary-distribution</id>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
            <configuration>
              <descriptors><descriptor>src/assembly/bin.xml</descriptor></descriptors>
              <finalName>fibra-${project.version}-bin</finalName>
              <appendAssemblyId>false</appendAssemblyId>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
