<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sstlfsj</groupId>
    <artifactId>fibra</artifactId>
    <version>${revision}</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>plugin-dependency-host</artifactId>
  <name>Fibra Plugin Dependency Host Example</name>
  <dependencies>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>plugin-dependency-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>fibra-runtime-java</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>fibra-registry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>shipping-rate-contract-plugin</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>shipping-rate-contract-plugin-v2</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>shipping-rate-provider-v1</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>shipping-rate-provider-v11</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sstlfsj</groupId>
      <artifactId>checkout-quote-consumer-plugin</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/fibra-example-plugin-dependency-host.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sstlfsj.fibra.example.dependency.PluginDependencyHost</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <fibra.example.contract.v1>${maven.multiModuleProjectDirectory}/fibra-example/plugin-dependency/contract-plugin/target/shipping-rate-contract-plugin-${project.version}.jar</fibra.example.contract.v1>
            <fibra.example.contract.v2>${maven.multiModuleProjectDirectory}/fibra-example/plugin-dependency/contract-plugin-v2/target/shipping-rate-contract-plugin-v2-${project.version}.jar</fibra.example.contract.v2>
            <fibra.example.provider.v1>${maven.multiModuleProjectDirectory}/fibra-example/plugin-dependency/provider-v1/target/shipping-rate-provider-v1-${project.version}.jar</fibra.example.provider.v1>
            <fibra.example.provider.v11>${maven.multiModuleProjectDirectory}/fibra-example/plugin-dependency/provider-v11/target/shipping-rate-provider-v11-${project.version}.jar</fibra.example.provider.v11>
            <fibra.example.consumer>${maven.multiModuleProjectDirectory}/fibra-example/plugin-dependency/consumer-plugin/target/checkout-quote-consumer-plugin-${project.version}.jar</fibra.example.consumer>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
